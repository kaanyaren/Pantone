{
  // unslop.palette.json — PantonAK owns these colours (Ak Nakış corporate:
  // white neutrals, near-black ink, plum #ae4a84 CTA with #515151 hover).
  // Declared = decided.
  "name": "PantonAK",

  "colors": {
    "ground":   "#ffffff",
    "panel":    "#f9f9f9",
    "recessed": "#f2f2f2",
    "ink":      "#0a0a0a",
    "ink2":     "#1d1d1d",
    "muted":    "#444444",
    "rule":     "#e3e3e3",
    "rule2":    "#767676",
    "deck":     "#0a0a0a",
    "deck2":    "#1d1d1d",
    "deck3":    "#2a2a2a",
    "deckInk":  "#ffffff",
    "deckMuted": "#e8e8e8",
    "deckRule": "#515151",
    "signal":   "#ae4a84",
    "signalHi": "#515151",
    "signalInk": "#ffffff",
    "focus":    "#ae4a84",
    "deckFocus": "#ffffff",
    "select":   "#f3dbe6",
    "exact":    "#005932",
    "exactBg":  "#d8eee1",
    "close":    "#6f5500",
    "closeBg":  "#efe8ce",
    "noticeable": "#9e4700",
    "noticeableBg": "#fae3d1",
    "loose":    "#a82700",
    "looseBg":  "#fee0d8",
    "note":     "#7444b4",
    "noteBg":   "#ebe4fa",
    "error":    "#ac040c",
    "errorBg":  "#fce1dd",
    "deckError": "#ff8f80"
  },

  "tolerance": { "hue": 12, "sat": 18, "light": 14 },

  // near-greys are structure, not brand: never reported as drift
  "neutralsAlwaysAllowed": true,

  // true if decorative one-offs outside the palette are fine
  "allowOffPaletteDecoration": false
}
